# Local backend
VITE_API_URL=http://localhost:4000/api

# Backend CORS, comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Backend only; never expose this value in Vercel
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Frontend only; same value as GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Password reset email via Resend
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=ExamAI <no-reply@your-domain.com>
APP_URL=http://localhost:5173

# Vercel frontend only; set this to the deployed Render API URL plus /api
# VITE_API_URL=https://smart-4ge3.onrender.com/api
